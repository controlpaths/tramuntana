# Local paths for build.sh. Copy to fw/.env and adjust; fw/.env is not
# versioned. Variables already set in the environment take precedence.

# Zephyr west workspace (contains zephyr/, modules/, .west/)
ZEPHYRPROJECT=$HOME/zephyrproject

# Zephyr SDK install directory (contains cmake/)
ZEPHYR_SDK=$HOME/zephyr-sdk-1.0.1

# west executable (default: the workspace's venv)
#WEST=$HOME/zephyrproject/.venv/bin/west

# CDC-ACM shell port used by 'build.sh flash' to reboot into the bootloader
#TRAMUNTANA_ACM_PORT=/dev/ttyACM0
